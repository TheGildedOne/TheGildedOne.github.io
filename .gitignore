# Built by GitHub Actions on every push — no need to commit it.
dist/

# Regenerated by build.py on every run. Kept out of git for the same reason as
# dist/: it is output, not source. If you ever want to move to WordPress, run
# `python build.py` and upload the file it produces.
wordpress-import.xml

# Service-account keys and anything else credential-shaped. Never commit this.
secrets/

# Local Claude Code config: permissions, and the preview server used to check
# site changes before they go live. Machine-specific, and the Saturday writing
# loop runs `git add -A`, so without this it would commit them.
.claude/

__pycache__/
*.pyc
.DS_Store
Thumbs.db
